{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@payload-config": ["./payload.config.ts"],
      "@artus-engineering/payload-visual-editor": ["../../packages/plugin/src/index.ts"],
      "@artus-engineering/payload-visual-editor/client": ["../../packages/plugin/src/exports/client.ts"],
      "@artus-engineering/payload-visual-editor-client": ["../../packages/client/src/index.ts"],
      "@artus-engineering/payload-visual-editor-client/react": ["../../packages/client/src/react/index.tsx"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
